# Development Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/tradedocs_dev
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
MONGO_DATABASE=tradedocs_dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker Configuration (Lower concurrency for development)
ONBOARDING_CHECKS_CONCURRENCY=2
EMAIL_PROCESSING_CONCURRENCY=1
DATA_EXTRACTION_CONCURRENCY=1
DOCUMENT_SIGNING_CONCURRENCY=1
DEAL_DESK_CONCURRENCY=1

# API Configuration
API_RATE_LIMIT_TTL=60
API_RATE_LIMIT_LIMIT=1000
API_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/app.log

# JWT Configuration
JWT_SECRET_KEY=dev-jwt-secret-key
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=dev-refresh-token-secret
REFRESH_TOKEN_EXPIRATION=7d

# Authentication Configuration
MFA_ENABLED=false
MFA_ISSUER=Trade Documents Platform (Dev)
MFA_WINDOW=1
MFA_BACKUP_CODES_COUNT=10
MFA_ALGORITHM=sha1
MFA_DIGITS=6
MFA_PERIOD=30
MFA_SECRET_LENGTH=20

# Password Policy (Relaxed for development)
PASSWORD_MIN_LENGTH=6
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_NUMBERS=false
PASSWORD_REQUIRE_SPECIAL=false

# Account Security (Relaxed for development)
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION=5

# Blockchain Configuration
CHAIN=amoy
CHAIN_ID=80002
TOKEN_REGISTRY_ADDRESS=
DOCUMENT_STORE_ADDRESS=

# External Services (Development keys)
BREVO_API_KEY=dev-brevo-api-key
BREVO_SENDER_EMAIL=dev@yourdomain.com
BREVO_SENDER_NAME=Trade Docs Platform (Dev)

# File Storage
FILE_STORAGE_PATH=./uploads/dev
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090

# Development Only
DEBUG_MODE=true
HOT_RELOAD=true

# Queue Names
DATA_EXTRACTION_QUEUE_NAME=data-extraction-dev
