# Database
MONGODB_URI=mongodb://localhost/tradedocs-test

# JWT Configuration
JWT_SECRET_KEY=test-jwt-secret-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=test-refresh-token-secret
REFRESH_TOKEN_EXPIRATION=7d

# Authentication Configuration - Disabled for testing
MFA_ENABLED=false
MFA_ISSUER=Trade Documents Platform Test
MFA_WINDOW=1
MFA_BACKUP_CODES_COUNT=5

# Password Policy - Relaxed for testing
PASSWORD_MIN_LENGTH=4
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_NUMBERS=false
PASSWORD_REQUIRE_SPECIAL=false

# Account Security - Disabled for testing
MAX_FAILED_LOGIN_ATTEMPTS=100
ACCOUNT_LOCKOUT_DURATION=0

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Blockchain Configuration
CHAIN=amoy
CHAIN_ID=80002
TOKEN_REGISTRY_ADDRESS=
DOCUMENT_STORE_ADDRESS=

# Other Configuration
NODE_ENV=test
PORT=3002
DATA_EXTRACTION_QUEUE_NAME=data-extraction-test 