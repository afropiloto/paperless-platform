# Multi-stage build for API application
# Security: Using specific Node.js version for reproducibility
FROM node:20-alpine3.19 AS builder

# Security: Set build arguments for potential build-time configuration
ARG NODE_ENV=production
ARG BUILD_DATE
ARG VCS_REF

# Security: Add labels for traceability and security scanning
LABEL maintainer="Trade Docs Platform" \
      org.opencontainers.image.title="Trade Docs API" \
      org.opencontainers.image.description="API application for Trade Docs Platform" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="1.0.0"

# Set working directory
WORKDIR /app

# Security: Copy package files first for better layer caching
COPY package*.json pnpm-lock.yaml ./

# Security: Install pnpm with specific version and verify checksum
# Using npm to install pnpm is acceptable in builder stage
RUN npm install -g pnpm@latest && \
    pnpm --version

# Security: Install dependencies with security flags
# --frozen-lockfile ensures reproducible builds
# --no-audit speeds up build (audit should be done in CI/CD)
RUN pnpm install --frozen-lockfile --no-audit

# Security: Copy source code (ensure .dockerignore is comprehensive)
COPY . .

# Build the application
RUN pnpm run build

# Production stage
# Security: Using same specific base image version
FROM node:20-alpine3.19 AS production

# Security: Set production environment
ENV NODE_ENV=production

# Security: Disable npm update notifications and telemetry
ENV npm_config_update_notifier=false \
    npm_config_audit=false \
    NPM_CONFIG_LOGLEVEL=warn

# Set working directory
WORKDIR /app

# Security: Copy package files for production dependencies
COPY package*.json pnpm-lock.yaml ./

# Security: Install pnpm only in production stage (needed for pnpm install)
# Consider removing after install if not needed at runtime
RUN npm install -g pnpm@latest && \
    pnpm --version

# Security: Install production dependencies only with security flags
RUN pnpm install --frozen-lockfile --prod --no-audit && \
    # Security: Remove npm and pnpm after installation to reduce attack surface
    npm uninstall -g pnpm && \
    # Security: Clean npm cache
    npm cache clean --force && \
    # Security: Remove package manager files
    rm -rf /tmp/* /var/cache/apk/* /root/.npm /root/.pnpm-store

# Security: Copy built application from builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public

# Security: Create non-root user with specific UID/GID
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001 -G nodejs

# Security: Set proper ownership and permissions
# Only give write access where necessary (e.g., logs, temp files)
RUN chown -R nestjs:nodejs /app && \
    # Security: Remove unnecessary permissions
    chmod -R 755 /app && \
    # Security: Ensure dist and public are readable
    chmod -R 644 /app/dist /app/public 2>/dev/null || true

# Security: Switch to non-root user before exposing filesystem
USER nestjs

# Security: Expose port (documentation only, doesn't actually publish)
EXPOSE 3001

# Security: Health check with proper error handling
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/api/healthcheck', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

# Security: Use exec form to ensure proper signal handling
# Security: Consider adding Node.js security flags if needed
CMD ["node", "dist/src/main-api.js"]
