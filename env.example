# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
# Note: MONGO_ROOT_USERNAME, MONGO_ROOT_PASSWORD, and MONGO_DATABASE are also used by docker-compose.yml
MONGODB_URI=mongodb://localhost:27017/tradedocs
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
MONGO_DATABASE=tradedocs

# Redis Configuration
# Note: REDIS_PASSWORD is also used by docker-compose.yml
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Docker Compose Configuration (for docker-compose.yml)
# These variables are used when running services via docker-compose
# Optional: Monitoring tool credentials
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=password
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=password

# Worker Configuration
ONBOARDING_CHECKS_CONCURRENCY=5
EMAIL_PROCESSING_CONCURRENCY=3
DATA_EXTRACTION_CONCURRENCY=2
DOCUMENT_SIGNING_CONCURRENCY=3
DEAL_DESK_CONCURRENCY=2

# API Configuration
API_RATE_LIMIT_TTL=60
API_RATE_LIMIT_LIMIT=100
API_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/app.log

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here
REFRESH_TOKEN_EXPIRATION=7d

# Authentication Configuration
MFA_ENABLED=true
MFA_ISSUER=Trade Documents Platform
MFA_WINDOW=1
MFA_BACKUP_CODES_COUNT=10
# New MFA Configuration Options
MFA_ALGORITHM=sha1
MFA_DIGITS=6
MFA_PERIOD=30
MFA_SECRET_LENGTH=20

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# Account Security
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15

# Blockchain Configuration
CHAIN=amoy
CHAIN_ID=80002
TOKEN_REGISTRY_ADDRESS=
DOCUMENT_STORE_ADDRESS=

# mLETR DvP Settlement Configuration
DVP_ESCROW_WALLET_ADDRESS=
DVP_ESCROW_WALLET_KEY=
STABLECOIN_USDC_CONTRACT_ADDRESS=
STABLECOIN_USDC_DECIMALS=6
STABLECOIN_USDT_CONTRACT_ADDRESS=
STABLECOIN_USDT_DECIMALS=6
DVP_SETTLEMENT_CONCURRENCY=2

# External Services
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Trade Docs Platform

# File Storage
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090

# Development Only
DEBUG_MODE=false
HOT_RELOAD=true

# Queue Names
DATA_EXTRACTION_QUEUE_NAME=data-extraction 