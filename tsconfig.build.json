{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "test",
    "dist",
    "**/*spec.ts",
    "**/*.e2e-spec.ts",
    "**/.pnpm/**",
    "**/@tradetrust-tt/**",
    "**/@typechain/**"
  ]
}
