{
  "name": "trade-docs-patform",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build-ignore-deps.js",
    "build:strict": "nest build",
    "build:api": "nest build",
    "build:worker": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:api": "node dist/src/main-api",
    "start:worker": "node dist/src/main-worker",
    "start:dev:api": "nest start --watch --entryFile main-api",
    "start:dev:worker": "nest start --watch --entryFile main-worker",
    "start:debug:api": "nest start --debug --watch --entryFile main-api",
    "start:debug:worker": "nest start --debug --watch --entryFile main-worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:unit": "jest --config ./test/jest-e2e.json --testPathPattern=\"controllers\" --maxWorkers=4",
    "test:e2e:integration": "jest --config ./test/jest-e2e.json --testPathPattern=\"integration\" --maxWorkers=2",
    "test:e2e:performance": "jest --config ./test/jest-e2e.json --testPathPattern=\"performance\" --maxWorkers=1",
    "test:e2e:coverage": "jest --config ./test/jest-e2e.json --coverage",
    "test:e2e:watch": "jest --config ./test/jest-e2e.json --watch",
    "test:e2e:debug": "jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles",
    "test:e2e:ci": "jest --config ./test/jest-e2e.json --ci --coverage --maxWorkers=2",
    "test:performance": "node scripts/generate-performance-report.js",
    "test:summary": "node scripts/generate-test-summary.js",
    "test:clean": "rm -rf test-results coverage-e2e performance-results",
    "script:deployTokenRegistry": "dotenv -e .env npx ts-node ./scripts/deployTokenRegistry.ts",
    "script:generateDidWeb": "dotenv -e .env npx ts-node ./scripts/generateDidWeb.ts",
    "script:generate-api-key": "ts-node ./scripts/generate-api-key.ts",
    "script:seed-module-permissions": "ts-node ./scripts/seed-module-permissions.ts",
    "script:seed-account-user": "ts-node ./scripts/seed-account-user.ts",
    "script:seed-due-diligence-checklists": "ts-node ./scripts/seed-due-diligence-checklists.ts",
    "script:add-onboarding-check": "dotenv -e .env -- npx ts-node ./scripts/add-onboarding-check.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/typeorm": "^11.0.0",
    "@tradetrust-tt/document-store": "^4.1.1",
    "@trustvc/trustvc": "^1.8.1",
    "@types/speakeasy": "^2.0.10",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "bullmq": "^5.66.6",
    "cache-manager": "^7.2.8",
    "clamav.js": "^0.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "ethers-v5": "npm:ethers@^5.8.0",
    "ethers-v6": "npm:ethers@^6.16.0",
    "express": "^5.2.1",
    "extend-ai": "^0.0.15",
    "jsonld": "^9.0.0",
    "mime-types": "^3.0.2",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.5",
    "multer": "^2.0.2",
    "otplib": "^13.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.17.2",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.2",
    "siwe": "^2.3.2",
    "speakeasy": "^2.0.0",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.12",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/clamav.js": "^0.12.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.30",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/valid-data-url": "^2.0.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", {
        "tsconfig": {
          "paths": {
            "src/*": ["src/*"]
          }
        },
        "useESM": false
      }]
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@scure|otplib|@otplib|qrcode)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
