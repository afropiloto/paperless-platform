  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "script:deployTokenRegistry": "dotenv -e .env npx ts-node ./scripts/deployTokenRegistry.ts",
    "script:generateDidWeb": "dotenv -e .env npx ts-node ./scripts/generateDidWeb.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.0.7",
    "@tradetrust-tt/document-store": "^4.1.1",
    "@trustvc/trustvc": "^1.4.7",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "body-parser": "^2.2.0",
    "bullmq": "^5.49.2",
    "cache-manager": "^6.4.2",
    "clamav.js": "^0.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.5.0",
    "ethers-v5": "npm:ethers@^5.8.0",
    "ethers-v6": "npm:ethers@^6.13.5",
    "jsonld": "^6.0.0",
    "mime-types": "^3.0.1",
    "mongodb": "^6.15.0",
    "mongoose": "^8.12.2",
    "multer": "1.4.5-lts.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.2",
    "siwe": "^2.1.4",
    "uuid": "^11.1.0"
