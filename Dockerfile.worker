# Multi-stage build for Worker application
# Security: Using specific Node.js version for reproducibility
FROM node:20-alpine3.19 AS builder

# Security: Set build arguments for potential build-time configuration
ARG NODE_ENV=production
ARG BUILD_DATE
ARG VCS_REF

# Security: Add labels for traceability and security scanning
LABEL maintainer="Trade Docs Platform" \
      org.opencontainers.image.title="Trade Docs Worker" \
      org.opencontainers.image.description="Worker application for Trade Docs Platform" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="1.0.0"

# Set working directory
WORKDIR /app

# Security: Copy package files first for better layer caching
COPY package*.json pnpm-lock.yaml ./

# Security: Install pnpm with specific version and verify checksum
# Using npm to install pnpm is acceptable in builder stage
RUN npm install -g pnpm@latest && \
    pnpm --version

# Security: Install dependencies with security flags
# --frozen-lockfile ensures reproducible builds
RUN pnpm install --frozen-lockfile

# Security: Copy source code (ensure .dockerignore is comprehensive)
COPY . .

# Build the application
RUN pnpm run build

# Prune to production dependencies only (avoids slow chown in production stage)
RUN pnpm prune --prod

# Production stage
# Security: Using same specific base image version
FROM node:20-alpine3.19 AS production

# Security: Set production environment
ENV NODE_ENV=production

# Security: Disable npm update notifications and telemetry
ENV npm_config_update_notifier=false \
    npm_config_audit=false \
    NPM_CONFIG_LOGLEVEL=warn

# Set working directory
WORKDIR /app

# Install procps-ng for healthcheck (pgrep command)
RUN apk add --no-cache procps-ng

# Security: Create non-root user first so COPY --chown avoids slow RUN chown
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001 -G nodejs

# Copy package files (needed for Node module resolution)
COPY --chown=nestjs:nodejs package*.json pnpm-lock.yaml ./

# Copy production node_modules and built app from builder (correct owner, no slow chown)
COPY --chown=nestjs:nodejs --from=builder /app/node_modules ./node_modules
COPY --chown=nestjs:nodejs --from=builder /app/dist ./dist

# Security: Switch to non-root user before exposing filesystem
USER nestjs

# Security: Health check for worker (check if process is running)
# Using pgrep from procps-ng package to verify worker process is alive
# Increased start-period for worker initialization
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD pgrep -f "main-worker.js" > /dev/null || exit 1

# Security: Use exec form to ensure proper signal handling
# Security: Consider adding Node.js security flags if needed
CMD ["node", "dist/src/main-worker.js"]
