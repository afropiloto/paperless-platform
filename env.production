# Production Environment Configuration
NODE_ENV=production
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://admin:${MONGO_ROOT_PASSWORD}@mongodb-service:27017/tradedocs?authSource=admin
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=${MONGO_ROOT_PASSWORD}
MONGO_DATABASE=tradedocs

# Redis Configuration
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# Worker Configuration (Higher concurrency for production)
ONBOARDING_CHECKS_CONCURRENCY=10
EMAIL_PROCESSING_CONCURRENCY=5
DATA_EXTRACTION_CONCURRENCY=3
DOCUMENT_SIGNING_CONCURRENCY=5
DEAL_DESK_CONCURRENCY=3

# API Configuration
API_RATE_LIMIT_TTL=60
API_RATE_LIMIT_LIMIT=100
API_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs/app.log

# JWT Configuration
JWT_SECRET_KEY=${JWT_SECRET_KEY}
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=${REFRESH_TOKEN_SECRET}
REFRESH_TOKEN_EXPIRATION=7d

# Authentication Configuration
MFA_ENABLED=true
MFA_ISSUER=Trade Documents Platform
MFA_WINDOW=1
MFA_BACKUP_CODES_COUNT=10
MFA_ALGORITHM=sha1
MFA_DIGITS=6
MFA_PERIOD=30
MFA_SECRET_LENGTH=20

# Password Policy (Strict for production)
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# Account Security (Strict for production)
MAX_FAILED_LOGIN_ATTEMPTS=3
ACCOUNT_LOCKOUT_DURATION=30

# Blockchain Configuration
CHAIN=amoy
CHAIN_ID=80002
TOKEN_REGISTRY_ADDRESS=${TOKEN_REGISTRY_ADDRESS}
DOCUMENT_STORE_ADDRESS=${DOCUMENT_STORE_ADDRESS}

# External Services
BREVO_API_KEY=${BREVO_API_KEY}
BREVO_SENDER_EMAIL=${BREVO_SENDER_EMAIL}
BREVO_SENDER_NAME=${BREVO_SENDER_NAME}

# File Storage
FILE_STORAGE_PATH=/app/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090

# Development Only
DEBUG_MODE=false
HOT_RELOAD=false

# Queue Names
DATA_EXTRACTION_QUEUE_NAME=data-extraction
